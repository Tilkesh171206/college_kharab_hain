# Secrets and environment variables
.env
*.env
!.env.example

# Python virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Pytest / test caches
.pytest_cache/
.coverage
htmlcov/

# Local data cache (keeps .gitkeep placeholders)
data/raw/*
data/processed/*
data/extracted/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/extracted/.gitkeep

# IDE and OS specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
